# Server-only credentials used by the AI interview audio transcription route.
# Copy this file to .dev.vars, add real values, and restart the local server.
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=

# Optional fallback provider.
OPENAI_API_KEY=

# Supabase private Storage (server only; never commit real values).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=
# Legacy JWT service_role key used only by the server-side Storage API.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=recruitment-files
